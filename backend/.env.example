# Sentinel backend configuration
# Copy this file to .env and adjust values for your environment.

# HTTP server
PORT=3000
ENVIRONMENT=development

# PostgreSQL database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinel
DB_USER=sentinel
DB_PASSWORD=changeme

# Authentication (min 32 chars; generate: openssl rand -base64 48)
JWT_SECRET=

# Network target restrictions
# When true (default), monitors and notification targets may point at
# private/loopback/link-local addresses (RFC1918, 127.0.0.0/8, etc.) - this is
# the normal case for monitoring devices on your own network. Cloud metadata
# addresses (169.254.169.254 and friends) are always blocked regardless of
# this setting. Set to false to also block private-range targets, e.g. on a
# deployment where invited (non-admin) users are less trusted.
ALLOW_PRIVATE_NETWORK_TARGETS=true

# Encryption key for notification secrets stored at rest (SMTP password,
# Telegram bot token, webhook URLs, ntfy auth token). Recommended: a random
# 32+ byte string, independent of JWT_SECRET.
# If unset, the key is derived from JWT_SECRET instead (still real
# encryption, just sharing key material with auth tokens). If neither is set,
# a well-known fallback key is used and a warning is logged - do not run
# production like this.
NOTIFICATION_SECRET_KEY=

# Comma-separated CIDRs Gin will trust X-Forwarded-For/X-Real-IP from (i.e.
# your reverse proxy's address). Defaults to common private-network ranges,
# which covers the bundled nginx container. Override only if you run behind
# a different proxy with a known, different address.
TRUSTED_PROXIES=
