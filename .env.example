# Sentinel — docker-compose environment.
# Copy to .env and adjust. Used by docker-compose.yml.

# Database
# Required. docker-compose will refuse to start without this set.
DB_PASSWORD=
DB_PORT=5432

# Server
# FRONTEND_PORT: host port for the web UI. BACKEND_PORT: host port for the API.
FRONTEND_PORT=3000
BACKEND_PORT=3001
ENVIRONMENT=production
LOG_LEVEL=info
TIMEZONE=UTC

# Database admin tool (Adminer, optional web UI for the database).
# ADMINER_PORT is the host port. To START Adminer, keep COMPOSE_PROFILES=adminer;
# to SKIP it, set COMPOSE_PROFILES= (empty). ADMINER_ENABLED is informational.
ADMINER_ENABLED=true
ADMINER_PORT=8080
COMPOSE_PROFILES=adminer

# Authentication — set a strong random secret of at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Self-registration. false = closed (default, recommended): the first account
# can always be created to bootstrap the admin, but no further sign-ups until an
# admin enables it under Security. Only seeds the initial value on first run.
REGISTRATION_ENABLED=false

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Connection security: none | starttls | ssltls
#   starttls -> plaintext connect then a required TLS upgrade (port 587)
#   ssltls   -> implicit TLS, handshake on connect (port 465)
#   none     -> plaintext; credentials are refused unless the host is local
# Unset falls back to the older boolean SMTP_TLS (false -> none, else starttls).
SMTP_SECURITY=starttls
# Skip TLS certificate verification. Insecure - only for a self-signed
# certificate on an internal mail server.
SMTP_SKIP_TLS_VERIFY=false

# Slack (optional)
SLACK_WEBHOOK_URL=

# Discord (optional)
DISCORD_WEBHOOK_URL=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ntfy (optional)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

# Custom Webhook (optional)
WEBHOOK_URL=

# Docker Registry (for pulling published images)
DOCKER_REGISTRY=ghcr.io
IMAGE_TAG=latest
